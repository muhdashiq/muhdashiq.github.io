{
  "name": "muhdashiq-projects",
  "private": true,
  "version": "3.0.0",
  "description": "Muhammed Ashiq's project catalog, served at muhdashiq.com",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
